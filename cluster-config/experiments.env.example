# Copy to cluster-config/experiments.env and adjust as needed.

# Modes: mpi, ms, both
MODE="both"

# Node-count matrices.
MPI_NODE_COUNTS_RAW="2 4 8"
MS_NODE_COUNTS_RAW="3 5 9"

# nBodies = 1 << (exp + 1)
# exp=18 => 2^19, exp=19 => 2^20
EXP_LIST_RAW="18 19"

# Per-case repetitions.
WARMUP_REPS=1
TIMED_REPS=2

# Build settings (no debug, no tracing intended for experiments).
DO_SYNC=1
DO_BUILD=1
BUILD_CLEAN=1
BUILD_ARGS_MPI="USE_MPI=1 USE_CUDA=1 DEBUG=0 GPU_ARCH=sm_89"
BUILD_ARGS_MS="USE_MPI=0 USE_CUDA=1 DEBUG=0 GPU_ARCH=sm_89"

# Runtime command bases.
MPI_RUN_BASE_ARGS="--mpi --classic --gpu"
MS_RUN_BASE_ARGS="--master-slave --classic --gpu"

# mpirun args.
GLOBAL_MPIRUN_ARGS="--bind-to none --tag-output"

# Optional network tuning / interface includes.
# Example:
# MPI_MPIRUN_ARGS_EXTRA="--mca oob_tcp_if_include 10.0.1.0/24 --mca btl_tcp_if_include 10.0.1.0/24 --mca btl self,vader,tcp"
MPI_MPIRUN_ARGS_EXTRA=""
MS_MPIRUN_ARGS_EXTRA=""

# Output path. If empty, script uses: results/experiments/<timestamp>
RESULTS_DIR=""

# Save full raw output for each run in results/experiments/<session>/logs.
SAVE_LOGS=1
